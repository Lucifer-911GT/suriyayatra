{
  "name": "suriyayatra",
  "version": "0.2.0",
  "description": "Thai suriyayatra (สุริยยาตร์) calculations: the Thai lunar calendar, holy days, planet positions (Sun to Uranus, Rahu, Ketu), sign changes, retrograde periods and the ascendant (lagna). Zero dependencies.",
  "keywords": [
    "thai",
    "calendar",
    "lunar",
    "suriyayatra",
    "สุริยยาตร์",
    "จันทรคติ",
    "วันพระ",
    "astrology",
    "โหราศาสตร์",
    "สมผุสดาว",
    "ลัคนา",
    "horakhun",
    "ephemeris",
    "ai-tools",
    "json-schema",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "Lucifer-911GT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lucifer-911GT/suriyayatra.git"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./tools": {
      "import": {
        "types": "./dist/tools.d.ts",
        "default": "./dist/tools.js"
      },
      "require": {
        "types": "./dist/cjs/tools.d.ts",
        "default": "./dist/cjs/tools.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "SOURCES.md",
    "bin",
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/finish-cjs.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:package",
    "check:package": "node scripts/check-package.cjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.2"
  },
  "module": "./dist/index.js",
  "bin": {
    "suriyayatra": "bin/suriyayatra.mjs"
  }
}
